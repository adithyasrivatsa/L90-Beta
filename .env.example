# ── L90 Configuration ──────────────────────────────────────────
# Google Gemini API
GOOGLE_API_KEY=your-api-key-here

# Model names (abstraction layer reads these)
WORKER_MODEL_NAME=gemini-2.5-flash
MANAGER_MODEL_NAME=gemini-2.5-flash
EMBEDDING_MODEL_NAME=gemini-embedding-001

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_data

# Blackboard persistence backend: "memory" or "redis"
BLACKBOARD_BACKEND=memory

# Redis (Phase 2 — only needed if BLACKBOARD_BACKEND=redis)
REDIS_URL=redis://localhost:6379/0

# Embedding settings
EMBEDDING_DIMENSION=3072
EMBEDDING_BATCH_SIZE=100
EMBEDDING_RPM_LIMIT=300

# Grounding enforcement
GROUNDING_CONFIDENCE_THRESHOLD=0.7

# Pipeline
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_CORRECTION_LOOPS=3
